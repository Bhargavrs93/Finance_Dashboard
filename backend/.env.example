NODE_ENV=development
PORT=5000

# Database
DB_PATH=./database/portfolio.db

# JWT
JWT_SECRET=change-this-to-a-random-secret-string
JWT_EXPIRY=30d

# Zerodha API (optional, not currently used for live data)
ZERODHA_API_KEY=your_api_key_here
ZERODHA_API_SECRET=your_api_secret_here

# Price APIs (free tier)
GOLD_PRICE_API=https://api.metals.live/v1/spot/gold
EXCHANGE_RATE_API=https://api.exchangerate-api.com/v4/latest

# Financial Independence target - not shown anywhere in the UI, used only
# to compute the FI Target/Progress figures on the Dashboard
ANNUAL_EXPENSES=50000
ANNUAL_EXPENSES_CURRENCY=AUD
